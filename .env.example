# Local development only. Copy to .env — never commit real credentials.
# Host port 5433: 5432 is often taken by a natively installed PostgreSQL.
POSTGRES_USER=webpul
POSTGRES_PASSWORD=webpul_dev
POSTGRES_DB=webpul
DATABASE_URL=postgresql://webpul:webpul_dev@localhost:5433/webpul
# Used by `prisma migrate dev` / drift check; created by docker/postgres-init.sql
SHADOW_DATABASE_URL=postgresql://webpul:webpul_dev@localhost:5433/webpul_shadow
REDIS_URL=redis://localhost:6379
