{
  "name": "adm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm --filter @webpul/web typecheck",
    "test": "pnpm --filter @webpul/web test",
    "dev": "pnpm --filter @webpul/web dev",
    "dev:web": "pnpm --filter @webpul/web dev",
    "build": "pnpm --filter @webpul/web build",
    "build:web": "pnpm --filter @webpul/web build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
