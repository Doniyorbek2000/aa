# Copy to deploy/.env on the server (/opt/webpul/deploy/.env) and fill in. Never commit .env.

# Live photoreal try-on (Decart Lucy VTON, realtime). Without it the site and app use the
# free on-device tracked overlay. Get a key at https://platform.decart.ai
DECART_API_KEY=
# Optional: comma-separated origins allowed to start live sessions (default https://a12.uz,https://www.a12.uz)
DECART_ALLOWED_ORIGINS=
# Optional: longest live session in seconds, caps the cost of one visit (default 180)
DECART_MAX_SESSION_SECONDS=
# Optional: live sessions the whole site may start per day, caps the daily bill (default 20)
DECART_MAX_SESSIONS_PER_DAY=

# Photo AI try-on (Leffa on Hugging Face). Without a token the free shared GPU quota runs out fast.
HF_TOKEN=
