# Copy to deploy/.env on the server (/opt/webpul/deploy/.env) and fill in. Never commit .env.

# Required: password for the app's own Postgres (generate: openssl rand -hex 24).
# Changing it later needs the same change inside the database too.
POSTGRES_PASSWORD=

# Live photoreal try-on (Decart Lucy VTON, realtime). Without it the site and app use the
# free on-device tracked overlay. Get a key at https://platform.decart.ai
DECART_API_KEY=
# Optional: comma-separated origins allowed to start live sessions (default https://a12.uz,https://www.a12.uz)
DECART_ALLOWED_ORIGINS=
# Optional: longest live session in seconds, caps the cost of one visit (default 180)
DECART_MAX_SESSION_SECONDS=
# Optional: live sessions the whole site may start per day, caps the daily bill (default 20)
DECART_MAX_SESSIONS_PER_DAY=

# Sign-in by SMS code through Eskiz.uz (https://notify.eskiz.uz). ESKIZ_TEMPLATE must match a
# template Eskiz approved, with {code} where the six digits go.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_TEMPLATE=A12 ilovasiga kirish kodi: {code}

# Sign-in with Google: the web OAuth client ID shows the button; GOOGLE_CLIENT_IDS lists every
# client allowed to sign in (web, Android, iOS), comma-separated.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Who gets the admin panel (/admin): comma-separated +998 numbers and/or Google emails
ADMIN_PHONES=
ADMIN_EMAILS=

# Photo AI try-on (Leffa on Hugging Face). Without a token the free shared GPU quota runs out fast.
HF_TOKEN=
