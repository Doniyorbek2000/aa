{
  "expo": {
    "name": "A12 Try-On",
    "slug": "a12-anywear-ai",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "../../logo.png",
    "userInterfaceStyle": "light",
    "scheme": "a12anywear",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.a12.anywear"
    },
    "android": {
      "package": "ai.a12.anywear",
      "adaptiveIcon": {
        "foregroundImage": "../../logo.png",
        "backgroundColor": "#fffffc"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.INTERNET"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      [
        "expo-splash-screen",
        { "image": "../../logo.png", "imageWidth": 180, "resizeMode": "contain", "backgroundColor": "#fffffc" }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A12 shows garments on you live through the camera. A photo is only sent when you tap AI try-on.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a garment photo from your gallery to try it on.",
          "cameraPermission": "A12 shows garments on you live through the camera."
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "https://a12.uz"
    }
  }
}
