{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": true,
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@webpul/shared-core": ["../../packages/shared-core/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "next.config.ts", "src", "../../packages/shared-core/src", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
